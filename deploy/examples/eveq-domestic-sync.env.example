EVEQ_REMOTE_HOST=ubuntu@<foreign-host>
EVEQ_SSH_KEY_PATH=/srv/eveqtrading/secrets/foreign-sync

EVEQ_REMOTE_DB_PATH=/srv/eveqtrading/data/eveq.db
EVEQ_REMOTE_EXPORT_ROOT=/srv/eveqtrading/export
EVEQ_REMOTE_RUNS_DIR=/srv/eveqtrading/runs
EVEQ_REMOTE_EXPORT_SCRIPT=/srv/eveqtrading/app/EVEQTrading/deploy/scripts/export_live_state.sh
# EVEQ_REMOTE_WORKER_STATE_PATH=/srv/eveqtrading/data/coverage-worker-state.json

EVEQ_LOCAL_DB_PATH=/srv/eveqtrading/data/eveq.db
EVEQ_LOCAL_RUNS_DIR=/srv/eveqtrading/runs
EVEQ_STAGING_DIR=/srv/eveqtrading/tmp/foreign-sync
EVEQ_LOG_DIR=/srv/eveqtrading/logs

EVEQ_SYNC_LOCK_FILE=/srv/eveqtrading/tmp/eveq-foreign-sync.lock
EVEQ_SYNC_LOCK_WAIT_SECONDS=300
EVEQ_PULL_RUNS=1

