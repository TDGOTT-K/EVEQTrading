[Unit]
Description=EVEQTrading region order mirror worker
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/eveqtrading/app/EVEQTrading
EnvironmentFile=/srv/eveqtrading/secrets/eveq-foreign-region-order-mirror-worker.env
ExecStart=/usr/bin/bash /srv/eveqtrading/app/EVEQTrading/deploy/scripts/run_region_order_mirror_worker.sh
SuccessExitStatus=3
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6

[Install]
WantedBy=multi-user.target
