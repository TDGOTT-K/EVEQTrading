EVEQ_APP_DIR=/srv/eveqtrading/app/EVEQTrading
EVEQ_VENV_DIR=/srv/eveqtrading/app/EVEQTrading/.venv
EVEQ_PYTHON_BIN=python3

EVEQ_DB_PATH=/srv/eveqtrading/data/eveq.db
EVEQ_OUTPUT_ROOT=/srv/eveqtrading/runs
EVEQ_LOG_DIR=/srv/eveqtrading/logs
EVEQ_LOCK_PATH=/srv/eveqtrading/tmp/eveq-jita-passive-cache-worker.lock
EVEQ_STATE_PATH=/srv/eveqtrading/data/jita-passive-cache-worker-state.json

EVEQ_REGION_ID=10000002

EVEQ_ORDERS_CHUNK_SIZE=50
EVEQ_MAX_ORDERS_CHUNKS=1
EVEQ_ORDERS_CACHE_PROFILE=warm

EVEQ_DATASOURCE=tranquility
EVEQ_ESI_BASE_URL=https://esi.evetech.net/latest
# Quote values with spaces so the same file works for both systemd EnvironmentFile and shell source.
EVEQ_ORDERS_USER_AGENT="EVEQTrading/0.1 foreign-jita-passive-cache-worker"
EVEQ_REQUEST_TIMEOUT_SECONDS=30
EVEQ_CONCURRENT_REQUESTS=4
EVEQ_MAX_RETRIES=3
EVEQ_PAUSE_SECONDS=0
EVEQ_ORDER_TYPE=all
EVEQ_ORDERS_FETCH_MODE=auto

EVEQ_CAPITAL_BUDGET_ISK=1000000000
EVEQ_TOP_N=50
EVEQ_MAX_FLIP_UNITS_CV_30D=0.30
EVEQ_MAX_FLIP_UNITS_CV_7D=0.50
EVEQ_MIN_DAILY_CAPACITY_ISK_30D=100000000
EVEQ_STRATEGY_SET=jita-passive-simple
EVEQ_PARAMETER_VERSION=v1-jita-passive-simple

EVEQ_FAILURE_BACKOFF_SECONDS=1800
EVEQ_MAX_RUNTIME_SECONDS=540
# EVEQ_MAX_CYCLES_PER_RUN=3

# DEBUG=1
