[Unit]
Description=Pull EVEQTrading foreign ingest state to domestic host
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/eveqtrading/app/EVEQTrading
EnvironmentFile=/srv/eveqtrading/secrets/eveq-domestic-sync.env
ExecStart=/srv/eveqtrading/app/EVEQTrading/deploy/scripts/pull_foreign_state.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
