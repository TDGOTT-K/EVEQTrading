EVEQ_APP_DIR=/srv/eveqtrading/app/EVEQTrading
EVEQ_VENV_DIR=/srv/eveqtrading/app/EVEQTrading/.venv
EVEQ_PYTHON_BIN=python3

EVEQ_DB_PATH=/srv/eveqtrading/data/eveq.db
EVEQ_OUTPUT_ROOT=/srv/eveqtrading/runs
EVEQ_LOG_DIR=/srv/eveqtrading/logs
EVEQ_LOCK_PATH=/srv/eveqtrading/tmp/eveq-history-sync-worker.lock
EVEQ_STATE_PATH=/srv/eveqtrading/data/history-sync-worker-state.json

EVEQ_REGION_ID=10000002

EVEQ_BACKFILL_CHUNK_SIZE=50
EVEQ_MAX_BACKFILL_CHUNKS=1
EVEQ_REFRESH_CHUNK_SIZE=200
EVEQ_MAX_REFRESH_CHUNKS=1
EVEQ_REFRESH_INTERVAL_HOURS=24
EVEQ_NOT_FOUND_RECHECK_HOURS=168
EVEQ_MAX_RUNTIME_SECONDS=540

# Optional hard stop on total cycle count inside one worker run.
# EVEQ_MAX_CYCLES_PER_RUN=20

EVEQ_DATASOURCE=tranquility
EVEQ_ESI_BASE_URL=https://esi.evetech.net/latest
# Quote values with spaces so the same file works for both systemd EnvironmentFile and shell source.
EVEQ_USER_AGENT="EVEQTrading/0.1 foreign-history-sync-worker"
EVEQ_REQUEST_TIMEOUT_SECONDS=30
EVEQ_CONCURRENT_REQUESTS=4
EVEQ_REQUEST_WALL_TIMEOUT_SECONDS=20
EVEQ_MAX_RETRIES=3
EVEQ_PAUSE_SECONDS=0
EVEQ_FAILURE_BACKOFF_SECONDS=1800

# EVEQ_LIMIT=500
# DEBUG=1
