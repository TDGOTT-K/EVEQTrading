EVEQ_APP_DIR=/srv/eveqtrading/app/EVEQTrading
EVEQ_VENV_DIR=/srv/eveqtrading/app/EVEQTrading/.venv
EVEQ_PYTHON_BIN=python3

EVEQ_DB_PATH=/srv/eveqtrading/data/eveq.db
EVEQ_OUTPUT_ROOT=/srv/eveqtrading/runs
EVEQ_LOG_DIR=/srv/eveqtrading/logs
EVEQ_LOCK_PATH=/srv/eveqtrading/tmp/eveq-coverage-worker.lock
EVEQ_STATE_PATH=/srv/eveqtrading/data/coverage-worker-state.json

EVEQ_REGION_ID=10000002

EVEQ_HISTORY_CHUNK_SIZE=5000
# EVEQ_MAX_HISTORY_CHUNKS=1
EVEQ_ORDERS_CHUNK_SIZE=5000
# EVEQ_MAX_ORDERS_CHUNKS=1
EVEQ_BENCHMARK_CHUNK_SIZE=1000
# EVEQ_BENCHMARK_MAX_CHUNKS=1

EVEQ_DATASOURCE=tranquility
EVEQ_ESI_BASE_URL=https://esi.evetech.net/latest
# Quote values with spaces so the same file works for both systemd EnvironmentFile and shell source.
EVEQ_HISTORY_USER_AGENT="EVEQTrading/0.1 foreign-coverage-worker-history"
EVEQ_ORDERS_USER_AGENT="EVEQTrading/0.1 foreign-coverage-worker-orders"
EVEQ_REQUEST_TIMEOUT_SECONDS=30
EVEQ_MAX_RETRIES=3
EVEQ_PAUSE_SECONDS=0
EVEQ_ORDER_TYPE=all

EVEQ_CAPITAL_BUDGET_ISK=1000000000
EVEQ_TEST_POSITION_ISK=250000000
EVEQ_TOP_N=10
EVEQ_STRATEGY_SET=v1-db-region
EVEQ_PARAMETER_VERSION=v1-db
# EVEQ_FAILURE_BACKOFF_SECONDS=1800

# DEBUG=1
